generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Subject {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  category  String
  topics    Topic[]
  questions Question[]
}

model Topic {
  id        Int        @id @default(autoincrement())
  name      String
  subjectId Int
  subject   Subject    @relation(fields: [subjectId], references: [id])
  questions Question[]

  @@unique([name, subjectId])
}

model Question {
  id          Int         @id @default(autoincrement())
  content     String
  modelAnswer String
  type        String      @default("essay")
  source      String      @default("formative")
  difficulty  Int         @default(3)
  pageRef     String?
  subjectId   Int
  topicId     Int?
  subject     Subject     @relation(fields: [subjectId], references: [id])
  topic       Topic?      @relation(fields: [topicId], references: [id])
  attempts    Attempt[]
  bookmarks   Bookmark[]
  blankItems  BlankItem[]
  createdAt   DateTime    @default(now())
}

model BlankItem {
  id         Int      @id @default(autoincrement())
  position   Int
  answer     String
  context    String
  questionId Int
  question   Question @relation(fields: [questionId], references: [id])
}

model User {
  id        Int        @id @default(autoincrement())
  username  String     @unique
  password  String
  name      String?
  createdAt DateTime   @default(now())
  attempts  Attempt[]
  bookmarks Bookmark[]
}

model Attempt {
  id         Int      @id @default(autoincrement())
  questionId Int
  question   Question @relation(fields: [questionId], references: [id])
  userAnswer String
  score      Int
  userId     Int?
  user       User?    @relation(fields: [userId], references: [id])
  createdAt  DateTime @default(now())
}

model Bookmark {
  id         Int      @id @default(autoincrement())
  questionId Int
  question   Question @relation(fields: [questionId], references: [id])
  note       String?
  userId     Int?
  user       User?    @relation(fields: [userId], references: [id])
  createdAt  DateTime @default(now())
}

model Setting {
  key   String @id
  value String
}
